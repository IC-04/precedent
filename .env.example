# Which LLM powers Ava. gemini | openai_compat | anthropic
PRECEDENT_PROVIDER=gemini

# Google Cloud / Vertex AI. Gemini always uses Application Default Credentials.
# Local development: gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global
PRECEDENT_MODEL=gemini-3.6-flash               # fastest measured per turn (2.6 s median, LOW thinking)
PRECEDENT_MODEL_STRONG=gemini-3.6-flash        # goal contract and company context (default thinking)
# Tried in order when the model above keeps returning 503 (overloaded) or 429.
# Preserve the existing Flash fallback chain; availability depends on your Cloud project.
PRECEDENT_MODEL_FALLBACK=gemini-3.7-flash,gemini-3.8-flash

# Open-weight models through any OpenAI-compatible server (Ollama, vLLM, OpenRouter, Groq)
# PRECEDENT_PROVIDER=openai_compat
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# PRECEDENT_MODEL=qwen3:32b

# Second model family through Amazon Bedrock (Tribunal jurors, reviewer, planner). Gemini stays primary.
# Check with: uv run precedent check-bedrock
AWS_BEARER_TOKEN_BEDROCK=                      # Bedrock API key; never commit it
AWS_REGION=us-east-1
# PRECEDENT_BEDROCK_PROJECT=proj_...           # optional Bedrock project, for cost tracking; default project otherwise
# Defaults measured on 2026-10-10; GPT-5.x/6.x need account access granted by AWS.
# PRECEDENT_BEDROCK_MODEL_JUDGE=qwen.qwen3-vl-235b-a22b-instruct   # structured answers over text and screenshots
# PRECEDENT_BEDROCK_MODEL_STRONG=xai.grok-4.3                      # disputes and planning
# PRECEDENT_BEDROCK_MODEL_SCREEN=openai.gpt-oss-safeguard-120b     # policy screening of untrusted text

# Anthropic, only if needed later: uv sync --extra anthropic
# PRECEDENT_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# PRECEDENT_MODEL=claude-sonnet-5-5

# Client-side throttle for free tiers (requests per minute; 0 = off)
PRECEDENT_RPM=10

PRECEDENT_APPS_URL=http://localhost:8100
PRECEDENT_SCENARIO_TOKEN=change-me      # make setup replaces this with a random token
PRECEDENT_MAX_STEPS=60
# Includes all model retries during preparation; prevents a silent, indefinite goal wait.
PRECEDENT_GOAL_TIMEOUT_SECONDS=120

# Thinking level for the action agent: low (default), medium, high, or default.
PRECEDENT_THINKING=low

# Real Google owner workspace. This is separate from Vertex inference / ADC.
# Web OAuth client JSON stays outside the repository, with 0600 permissions.
# PRECEDENT_GOOGLE_CLIENT_FILE=~/.local/share/precedent/google-oauth.json
# PRECEDENT_GOOGLE_REDIRECT_URI=http://localhost:8251/oauth/gmail/callback
# Optional environment configuration instead of a private client JSON:
# PRECEDENT_GOOGLE_CLIENT_ID=
# PRECEDENT_GOOGLE_CLIENT_SECRET=
# PRECEDENT_CONNECTED_ROOT=.connected
# PRECEDENT_CONNECTED_KEY_FILE=~/.local/share/precedent/connected.key
# Acceptance testing only: suppress the first native save acknowledgement after commit.
# PRECEDENT_GOOGLE_LOST_ACK_ONCE=1
